{
  "_tier": "High \u2014 strong VPS/dedicated, 100-500 concurrent users.",
  "__usage": "Fill in SERVER_SPOOF_IP / CLIENT_REAL_IP / CLIENT_SPOOF_IP / keys, then run: quiccochet -c high-server.json",
  "___obfuscation": "obfuscation.mode is \"none\" by default for max throughput. Switch to \"standard\" only if this deployment is actually under active DPI (padding costs real CPU under load \u2014 see docs/PROFILING-BASELINE.md).",
  "mode": "server",
  "transport": {
    "type": "udp"
  },
  "listen_port": 8080,
  "spoof": {
    "source_ips": [
      "SERVER_SPOOF_IP"
    ]
  },
  "crypto": {
    "private_key": ""
  },
  "peers": [
    {
      "name": "vpn1",
      "peer_public_key": "",
      "client_real_ip": "CLIENT_REAL_IP",
      "peer_spoof_ips": [
        "CLIENT_SPOOF_IP"
      ],
      "tun_addr": "10.20.0.2"
    }
  ],
  "tun": {
    "enabled": true,
    "name": "qc0",
    "local": "10.20.0.1/24",
    "queues": 4,
    "pin_cores": true
  },
  "obfuscation": {
    "mode": "none"
  },
  "quic": {
    "pool_size": 10,
    "congestion_control": "bbrv1"
  },
  "performance": {
    "read_buffer": 25165824,
    "write_buffer": 25165824
  },
  "security": {
    "block_private_targets": true
  },
  "logging": {
    "level": "info",
    "file": ""
  },
  "metrics": {
    "enabled": true,
    "listen": "127.0.0.1:9201"
  }
}
