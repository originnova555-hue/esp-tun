{
  "_tier": "Light — weak VPS, 1-20 concurrent users. Lowest CPU/RAM floor.",
  "__usage": "Fill in SERVER_SPOOF_IP / CLIENT_REAL_IP / CLIENT_SPOOF_IP / keys, then run: quiccochet -c light-server.json",

  "mode": "server",
  "transport": { "type": "udp" },
  "listen_port": 8080,

  "spoof": { "source_ips": ["SERVER_SPOOF_IP"] },
  "crypto": { "private_key": "" },
  "peers": [
    {
      "name": "vpn1",
      "peer_public_key": "",
      "client_real_ip": "CLIENT_REAL_IP",
      "peer_spoof_ips": ["CLIENT_SPOOF_IP"],
      "tun_addr": "10.20.0.2"
    }
  ],

  "tun": {
    "enabled": true,
    "name": "qc0",
    "local": "10.20.0.1/24",
    "mtu": 1360,
    "queues": 1,
    "pin_cores": false
  },

  "obfuscation": { "mode": "none" },
  "quic": {
    "pool_size": 2,
    "congestion_control": "cubic"
  },
  "performance": {
    "read_buffer": 4194304,
    "write_buffer": 4194304
  },

  "security": { "block_private_targets": true },
  "logging": { "level": "info", "file": "" },
  "metrics": { "enabled": false, "listen": "127.0.0.1:9201" }
}
